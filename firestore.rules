rules_version = '2';

/*
 * What the client is allowed to do, enforced by the database.
 *
 * The guiding rule here is that nothing important is true only because the
 * client agreed to it. A best score cannot go down, a published quiz cannot
 * change without its version stepping, and the popularity counter cannot move
 * except alongside a marker that the same person can create exactly once and
 * can never delete. Each of those is a promise the app makes; each is a promise
 * the app is not trusted to keep on its own.
 *
 * What rules cannot do is loop, so nothing here can check an *element* of
 * `features`. Shape and size only — `web/src/lib/codec.ts` is what stands
 * between whatever gets through and a round.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    /*
     * Does this account have a real identity attached?
     *
     * Anonymous accounts are lost with the site data. Playing and building are
     * fine on one; publishing is not, because a published quiz whose author
     * cannot be reached is worse than no publish button.
     *
     * Asked of `identities` and **not** of `sign_in_provider`, which is the
     * obvious field and the wrong one. `sign_in_provider` records how the
     * current session was established and does not change when an account is
     * linked — so someone who signed in anonymously and then signed up with
     * Google carries a token that still says `anonymous`, on an account that is
     * anything but, until they next sign in from scratch. That is the ordinary
     * path through this app rather than an edge case, and it made publishing
     * impossible for exactly the people entitled to do it.
     *
     * `identities` is a map of the providers actually on the account, so it is
     * empty for an anonymous one and filled the moment a link succeeds. Guarded
     * for its own absence, since not every token carries it.
     */
    function isNamed() {
      return signedIn()
        && 'identities' in request.auth.token.firebase
        && request.auth.token.firebase.identities.keys().size() > 0;
    }

    function touched() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validQuiz(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.bbox is list && d.bbox.size() == 4
          && d.features is list && d.features.size() > 0 && d.features.size() <= 400;
    }

    function validPct(v) { return v is int && v >= 0 && v <= 100; }

    match /users/{uid} {
      // Public, because a published quiz shows who made it and should not need
      // a second read to say so. Nothing else lives here.
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40));
      allow delete: if false;

      match /quizzes/{quizId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validQuiz(request.resource.data);
      }

      match /progress/{quizId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validPct(request.resource.data.best);
        // Monotone, and enforced here rather than agreed between clients: a
        // device that has been offline for a week must not be able to push a
        // stale score over a better one it never saw.
        allow update: if isOwner(uid)
          && validPct(request.resource.data.best)
          && request.resource.data.best >= resource.data.best;
      }
    }

    match /published/{quizId} {
      allow get, list: if true;

      allow create: if isNamed()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.version == 1
        && request.resource.data.players == 0
        && request.resource.data.hidden == false
        && validQuiz(request.resource.data);

      allow update: if
        // The author republishing. An explicit act, and it steps the version:
        // that is what makes "frozen" mean something, and what keeps a score
        // attached to the question set it was earned against.
        (isNamed()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.players == resource.data.players
          && request.resource.data.hidden == resource.data.hidden
          && validQuiz(request.resource.data))
        ||
        // A player finishing a round for the first time. Only the counter
        // moves, only by one, and only in the same commit that creates their
        // marker — which they can create once and never delete. So `players`
        // is provably the number of distinct people who have finished it.
        (signedIn()
          && touched().hasOnly(['players'])
          && request.resource.data.players == resource.data.players + 1
          && !exists(/databases/$(database)/documents/published/$(quizId)/players/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/published/$(quizId)/players/$(request.auth.uid)));

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /players/{playerId} {
        allow get: if isOwner(playerId);
        allow list: if false;
        allow create: if isOwner(playerId);
        // Never: a marker that could be removed is a counter that could be
        // spent twice.
        allow update, delete: if false;
      }

      match /versions/{version} {
        allow get, list: if true;
        // `getAfter`, not `get`: the first version is written in the same
        // transaction that creates the quiz it belongs to, so at the moment
        // this is evaluated `get` would be reading a document that does not
        // exist yet and the very first publish would be refused.
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/published/$(quizId)).data.ownerId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
