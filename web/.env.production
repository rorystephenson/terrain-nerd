# The rendered basemap tiles, in Cloudflare R2 behind a custom domain.
#
# Only set for production builds. A dev server leaves it unset and reads tiles
# straight out of pipeline/cache/tiles instead, so local work needs no upload
# and keeps working offline.
VITE_TILE_BASE=https://tiles.balanci.ng

# The feature pool, in the same R2 bucket as the tiles. Only set for
# production builds; a dev server reads it out of pipeline/cache/data instead.
VITE_DATA_BASE=https://tiles.balanci.ng/data
